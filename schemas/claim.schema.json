{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence Claim",
  "type": "object",
  "required": [
    "claim_id",
    "statement",
    "status",
    "source_refs"
  ],
  "properties": {
    "claim_id": {
      "type": "string"
    },
    "statement": {
      "type": "string"
    },
    "status": {
      "enum": [
        "supported",
        "disputed",
        "unknown",
        "superseded"
      ]
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "jurisdiction": {
      "type": [
        "string",
        "null"
      ]
    },
    "effective_from": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "effective_to": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    }
  }
}
